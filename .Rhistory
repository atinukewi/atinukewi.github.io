test_that("smallest_penguin has the correct column names", {
expected_names <- c("species", "island", "bill_length_mm", "bill_depth_mm",
"flipper_length_mm", "body_mass_g", "sex", "year")
expect_setequal(colnames(smallest_penguin), expected_names)
})
test_that("smallest_penguin has the correct values", {
expect_equal(smallest_penguin$species[1], "Chinstrap")
expect_equal(smallest_penguin$bill_length_mm[1], 46.9, tolerance = 1.5e-08)
})
penguins_plot <- ggplot(penguins_csv, aes(x = flipper_length_mm,
y = body_mass_g)) +
geom_point(aes(color = sex), size = 3, alpha = 0.5) +
theme_minimal() +
scale_color_manual(values = c("darkorange","cyan4"), na.translate = FALSE) +
scale_x_continuous(breaks = scales::pretty_breaks(n = 3)) +
labs(title = "Gentoo penguin species are larger",
x = "Flipper length (mm)",
y = "Body mass (g)",
color = "Penguin sex") +
theme(legend.position = "top",
legend.background = element_rect(fill = "white", color = NA),
plot.title.position = "plot",
plot.caption = element_text(hjust = 0, face= "italic"),
plot.caption.position = "plot",
text = element_text(size = 16),
axis.text.x = element_text(angle = 45, hjust = 1)) +
facet_wrap(~species)
penguins_plot
