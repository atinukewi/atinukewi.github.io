library(tidyverse)
library(testthat)
penguins_csv <- read_csv("data/penguins.csv")
head(penguins_csv)
# TESTS
test_that("penguins_csv loads successfully", {
expect_true(!is.null(penguins_csv))
expect_s3_class(penguins_csv, "data.frame")
})
test_that("penguins_csv has the correct dimensions", {
expect_equal(nrow(penguins_csv), 344)
expect_equal(ncol(penguins_csv), 8)
})
test_that("penguins_csv has the correct column names", {
expected_names <- c("species", "island", "bill_length_mm", "bill_depth_mm",
"flipper_length_mm", "body_mass_g", "sex", "year")
expect_setequal(colnames(penguins_csv), expected_names)
})
test_that("penguins_csv has correct bill_length_mm values", {
expect_equal(sum(penguins_csv$bill_length_mm, na.rm = TRUE), 15021.3, tolerance = 1.5e-08)
expect_equal(mean(penguins_csv$bill_length_mm, na.rm = TRUE), 43.92193, tolerance = 1.5e-08)
expect_equal(sum(is.na(penguins_csv$bill_length_mm)), 2)
})
test_that("penguins_csv has correct bill_length_mm values", {
expect_equal(sum(penguins_csv$bill_length_mm, na.rm = TRUE), 15021.3, tolerance = 1.5e-08)
expect_equal(mean(penguins_csv$bill_length_mm, na.rm = TRUE), 43.92193, tolerance = 1.5e-08)
expect_equal(sum(is.na(penguins_csv$bill_length_mm)), 2)
})
