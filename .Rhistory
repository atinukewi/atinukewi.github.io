test_that("flight_tidy2 loads successfully", {
expect_true(!is.null(flight_tidy2))
expect_s3_class(flight_tidy2, "data.frame")
})
test_that("flight_tidy2 has the correct dimensions", {
expect_equal(nrow(flight_tidy2), 6)
expect_equal(ncol(flight_tidy2), 4)
})
test_that("flight_tidy2 has the correct column names", {
expected_names <- c("airline", "date", "flight", "duration")
expect_setequal(colnames(flight_tidy2), expected_names)
})
test_that("flight_tidy2 has correct duration values", {
expect_equal(flight_tidy2$duration, c(315, 318, 300, 320, 305, 300))
})
