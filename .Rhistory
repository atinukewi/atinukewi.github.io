expect_equal(ncol(female_penguins), 8)
})
test_that("female_penguins has the correct column names", {
expected_names <- c("species", "island", "bill_length_mm", "bill_depth_mm",
"flipper_length_mm", "body_mass_g", "sex", "year")
expect_setequal(colnames(female_penguins), expected_names)
})
test_that("female_penguins has correct bill_length_mm values", {
expect_equal(sum(female_penguins$bill_length_mm, na.rm = TRUE), 6946, tolerance = 1.5e-08)
expect_equal(mean(female_penguins$bill_length_mm, na.rm = TRUE), 42.09697, tolerance = 1.5e-08)
expect_equal(sum(is.na(female_penguins$bill_length_mm)), 0)
})
ordered_by_size <- arrange(penguins.csv, body_mass_g)
ordered_by_size <- arrange(penguins_csv, body_mass_g)
head(ordered_by_size)
# TESTS
test_that("ordered_by_size loads successfully", {
expect_true(!is.null(ordered_by_size))
expect_s3_class(ordered_by_size, "data.frame")
})
test_that("ordered_by_size has the correct dimensions", {
expect_equal(nrow(ordered_by_size), 344)
expect_equal(ncol(ordered_by_size), 8)
})
test_that("ordered_by_size has the correct column names", {
expected_names <- c("species", "island", "bill_length_mm", "bill_depth_mm",
"flipper_length_mm", "body_mass_g", "sex", "year")
expect_setequal(colnames(ordered_by_size), expected_names)
})
test_that("ordered_by_size is sorted by body_mass_g in ascending order", {
expect_false(is.unsorted(ordered_by_size$body_mass_g, na.rm = TRUE))
})
test_that("ordered_by_size has the correct first row after sorting", {
expect_equal(ordered_by_size$species[1], "Chinstrap")
expect_equal(ordered_by_size$bill_length_mm[1], 46.9, tolerance = 1.5e-08)
})
test_that("ordered_by_size has correct bill_length_mm values overall", {
expect_equal(sum(ordered_by_size$bill_length_mm, na.rm = TRUE), 15021.3, tolerance = 1.5e-08)
})
smallest_penguin <- slice(ordered_by_size, 0)
smallest_penguin
smallest_penguin <- slice(ordered_by_size, 1)
smallest_penguin
# TESTS
test_that("smallest_penguin loads successfully", {
expect_true(!is.null(smallest_penguin))
expect_s3_class(smallest_penguin, "data.frame")
})
